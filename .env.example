# Environment for the Glocal Sport API on Render (Environment → "Add from .env" accepts this format).
# Copy it, fill in the <…> values, paste it into Render. Never commit the filled-in copy.

# --- required -----------------------------------------------------------------------------
PYTHON_VERSION=3.14.5
DJANGO_SETTINGS_MODULE=config.settings.production
# A long random value, e.g. from: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=<long random value>
# The NEW database's "Internal Database URL" (Render → the database → Connect). Same region as the service.
DATABASE_URL=<postgresql://…>
# gunicorn workers; 2 fits the free plan's memory.
WEB_CONCURRENCY=2
# Who can sign in to /admin/: phone numbers of accounts already created in the app, comma-separated.
GLOCAL_ADMIN_PHONES=<+2126XXXXXXXX>

# --- optional -----------------------------------------------------------------------------
# Render sets RENDER_EXTERNAL_HOSTNAME itself; list extra hosts only for a custom domain.
# ALLOWED_HOSTS=api.example.com
# Only if the logs say the database doesn't support SSL.
# DB_SSLMODE=prefer
# Phone codes stay off. To turn them on later see the README (PHONE_CODES_ENABLED, OTP_*, TWILIO_*).
